# All settings use the OCR_WORKER_ prefix. Lists are comma separated.
OCR_WORKER_ENVIRONMENT=development
OCR_WORKER_LOG_LEVEL=INFO
# Shared service token (Authorization: Bearer or X-Internal-Token). Mount from OpenBao in
# staging/production; leave unset only for local development.
# OCR_WORKER_INTERNAL_TOKEN=
OCR_WORKER_MAX_IMAGES=2
OCR_WORKER_MAX_IMAGE_BYTES=8388608
OCR_WORKER_MAX_REQUEST_BYTES=25165824
OCR_WORKER_MAX_IMAGE_PIXELS=40000000
OCR_WORKER_MAX_IMAGE_SIDE=10000
OCR_WORKER_MIN_IMAGE_WIDTH=320
OCR_WORKER_MIN_IMAGE_HEIGHT=200
OCR_WORKER_REQUEST_TIMEOUT_SECONDS=30
OCR_WORKER_MAX_CONCURRENCY=2
OCR_WORKER_QUEUE_TIMEOUT_SECONDS=2
OCR_WORKER_ENGINES=tesseract
OCR_WORKER_DEFAULT_ENGINE=tesseract
OCR_WORKER_TESSERACT_LANGUAGES=spa,eng
OCR_WORKER_LOW_CONFIDENCE_THRESHOLD=0.6
OCR_WORKER_QR_ALLOWED_HOSTS=licencias.intrantmoto.com
