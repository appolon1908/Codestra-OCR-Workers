{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "codestra.ocr.extraction-result/v1",
  "title": "OCR worker extraction result (v1)",
  "description": "Response contract returned by Codestra-OCR-Workers to Document Intelligence. Any response that does not validate is rejected as a schema mismatch.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_ref", "request_id", "worker", "document_type", "country", "fields", "image_digests", "quality"],
  "properties": {
    "schema_ref": {"const": "codestra.ocr.extraction-result/v1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 64},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "engine": {"type": "string", "maxLength": 64}
      }
    },
    "document_type": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
    "country": {"type": "string", "pattern": "^[A-Z]{2,3}$"},
    "fields": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
      "additionalProperties": {"$ref": "#/$defs/field"}
    },
    "image_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["front"],
      "properties": {
        "front": {"$ref": "#/$defs/sha256"},
        "back": {"$ref": "#/$defs/sha256"}
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall_confidence"],
      "properties": {
        "overall_confidence": {"$ref": "#/$defs/confidence"},
        "warnings": {"type": "array", "maxItems": 32, "items": {"type": "string", "maxLength": 128}}
      }
    },
    "qr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present"],
      "properties": {
        "present": {"type": "boolean"},
        "source_lookup_url": {"type": ["string", "null"], "maxLength": 2048}
      }
    },
    "portrait": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detected"],
      "properties": {
        "detected": {"type": "boolean"},
        "side": {"enum": ["front", "back"]}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence"],
      "properties": {
        "value": {"type": ["string", "null"], "maxLength": 512},
        "confidence": {"$ref": "#/$defs/confidence"},
        "source": {"enum": ["visual", "mrz", "barcode", "qr"]},
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "side": {"enum": ["front", "back"]},
            "bbox": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    }
  }
}
